      "task": "rewrite_note_to_house_style_ukrainian",
      "source_note_path": "Inbox/Ukrainian Grammar/Signals Draft.md",
      "title": "Signals in Linux",
      "instruction": "\u041f\u0435\u0440\u0435\u043f\u0438\u0448\u0438 \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0443 \u043d\u043e\u0442\u0430\u0442\u043a\u0443 \u0432 house style. \u0417\u0431\u0435\u0440\u0435\u0436\u0438 Obsidian-\u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f, \u0434\u043e\u0434\u0430\u0439 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u0443 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0442\u0430 \u043f\u0440\u0438\u0431\u0435\u0440\u0438 \u0440\u043e\u0437\u043c\u043e\u0432\u043d\u0456 \u0444\u043e\u0440\u043c\u0443\u043b\u044e\u0432\u0430\u043d\u043d\u044f.",
      "input_markdown": "# Signals in Linux\n## short\n\u0421\u0438\u0433\u043d\u0430\u043b\u0438 \u0446\u0435 \u0441\u043f\u043e\u0441\u0456\u0431 \u0441\u043a\u0430\u0437\u0430\u0442\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0443 \u0449\u043e \u0449\u043e\u0441\u044c \u0441\u0442\u0430\u043b\u043e\u0441\u044c. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 SIGINT \u0447\u0430\u0441\u0442\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u044c \u043a\u043e\u043b\u0438 \u044e\u0437\u0435\u0440 \u0442\u0438\u0441\u043d\u0435 ctrl-c. \u0414\u0438\u0432\u0438\u0441\u044c [Processes and Signals](/Processes and Signals.md).\n",
      "target_markdown": "# Signals in Linux\n\n## Basics\n\u0421\u0438\u0433\u043d\u0430\u043b\u0438 \u0434\u0430\u044e\u0442\u044c \u0437\u043c\u043e\u0433\u0443 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u0438\u0442\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0443, \u0449\u043e \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u0435\u0432\u043d\u0430 \u043f\u043e\u0434\u0456\u044f.\n\n\u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, `SIGINT` \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0434\u0445\u043e\u0434\u0438\u0442\u044c \u0442\u043e\u0434\u0456, \u043a\u043e\u043b\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u0454 `Ctrl-C`.\n\nSee [[Processes and Signals]].\n",
      "tags": [
        "ukrainian",
        "obsidian_links",
        "house_style",
        "linux",
        "signals"
      ]
    },
    {
      "example_id": "ukrainian::normalization::threads",
      "source": "ukrainian",
      "quality_tier": "gold",
      "task": "ukrainian_surzhyk_normalization",
      "source_note_path": "Inbox/Ukrainian Grammar/Threads Draft.md",
      "title": "Threads and Synchronization",
      "instruction": "\u041d\u043e\u0440\u043c\u0430\u043b\u0456\u0437\u0443\u0439 \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0438\u0439 \u0442\u0435\u043a\u0441\u0442. \u0417\u0430\u043c\u0456\u043d\u044e\u0439 \u0441\u0443\u0440\u0436\u0438\u043a \u0456 \u043d\u0435\u0432\u0434\u0430\u043b\u0456 \u043a\u0430\u043b\u044c\u043a\u0438 \u043d\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0456 \u0444\u043e\u0440\u043c\u0443\u043b\u044e\u0432\u0430\u043d\u043d\u044f, \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0447\u0438 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0443 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c.",
      "input_markdown": "# Threads and Synchronization\n\n\u041a\u043e\u043b\u0438 \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u0430 \u043f\u043e\u0442\u043e\u043a\u0456\u0432 \u043f\u0440\u0430\u0446\u044e\u044e\u0442\u044c \u0437 \u043e\u0434\u043d\u0438\u043c\u0438 \u0456 \u0442\u0438\u043c\u0438 \u0436\u0435 \u0434\u0430\u043d\u0438\u043c\u0438, \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u043d\u0438\u043a\u0430\u0442\u0438 \u0433\u043e\u043d\u043a\u0438. \u0429\u043e\u0431 \u0446\u044c\u043e\u0433\u043e \u0456\u0437\u0431\u0456\u0436\u0430\u0442\u0438, \u0442\u0440\u0435\u0431\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c mutex \u0430\u0431\u043e \u0456\u043d\u0448\u0456 \u043f\u0440\u0438\u043c\u0456\u0442\u0438\u0432\u0438 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u0457.\n",
      "target_markdown": "# Threads and Synchronization\n\n\u041a\u043e\u043b\u0438 \u043a\u0456\u043b\u044c\u043a\u0430 \u043f\u043e\u0442\u043e\u043a\u0456\u0432 \u043f\u0440\u0430\u0446\u044e\u044e\u0442\u044c \u0437 \u043e\u0434\u043d\u0438\u043c\u0438 \u0439 \u0442\u0438\u043c\u0438 \u0441\u0430\u043c\u0438\u043c\u0438 \u0434\u0430\u043d\u0438\u043c\u0438, \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u043d\u0438\u043a\u0430\u0442\u0438 race conditions.\n\n\u0429\u043e\u0431 \u0446\u044c\u043e\u0433\u043e \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438, \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 `mutex` \u0430\u0431\u043e \u0456\u043d\u0448\u0456 \u043f\u0440\u0438\u043c\u0456\u0442\u0438\u0432\u0438 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u0457.\n",
      "tags": [
        "ukrainian",
