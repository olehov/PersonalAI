      "example_id": "ukrainian::grammar::shell_note_cleanup",
      "source": "ukrainian",
      "quality_tier": "gold",
      "task": "ukrainian_grammar_cleanup",
      "source_note_path": "Inbox/Ukrainian Grammar/Shell Note Draft.md",
      "title": "Shell Note Grammar Cleanup",
      "instruction": "\u0412\u0438\u043f\u0440\u0430\u0432 \u0442\u0435\u043a\u0441\u0442 \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e \u043c\u043e\u0432\u043e\u044e. \u041f\u0440\u0438\u0431\u0435\u0440\u0438 \u0440\u0443\u0441\u0438\u0437\u043c\u0438, \u0432\u0438\u043f\u0440\u0430\u0432 \u0433\u0440\u0430\u043c\u0430\u0442\u0438\u043a\u0443, \u043f\u0443\u043d\u043a\u0442\u0443\u0430\u0446\u0456\u044e \u0442\u0430 \u0443\u0437\u0433\u043e\u0434\u0436\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0438 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0438\u0439 \u0437\u043c\u0456\u0441\u0442.",
      "input_markdown": "# Shell\n\n\u0426\u044f \u043d\u043e\u0434\u0430 \u043e\u043f\u0438\u0441\u0443\u0454 \u044f\u043a \u0448\u0435\u043b\u043b \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454 \u043a\u043e\u043c\u0430\u043d\u0434\u0438 \u0456 \u043e\u0431\u0440\u043e\u0431\u043b\u044f\u0454 \u043f\u0430\u0439\u043f\u0438. \u042f\u043a\u0449\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u0430 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u0430, \u0442\u0440\u0435\u0431\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u043f\u043e\u043d\u044f\u0442\u043d\u0443 \u043f\u043e\u043c\u0438\u043b\u043a\u0443 \u0456 \u043d\u0435 \u043b\u0430\u043c\u0430\u0442\u0438 \u0432\u0435\u0441\u044c \u043f\u0440\u043e\u0446\u0435\u0441. \u0422\u0430\u043a\u043e\u0436 \u0442\u0440\u0435\u0431\u0430 \u0441\u043b\u0456\u0434\u043a\u0443\u0432\u0430\u0442\u0438 \u0437\u0430 \u0442\u0438\u043c, \u0449\u043e\u0431 \u0434\u0435\u0441\u043a\u0440\u0438\u043f\u0442\u043e\u0440\u0438 \u0444\u0430\u0439\u043b\u0456\u0432 \u0437\u0430\u043a\u0440\u0438\u0432\u0430\u043b\u0438\u0441\u044c \u0432\u0447\u0430\u0441\u043d\u043e.\n",
      "target_markdown": "# Shell\n\n\u0426\u044f \u043d\u043e\u0442\u0430\u0442\u043a\u0430 \u043e\u043f\u0438\u0441\u0443\u0454, \u044f\u043a shell \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454 \u043a\u043e\u043c\u0430\u043d\u0434\u0438 \u0442\u0430 \u043e\u0431\u0440\u043e\u0431\u043b\u044f\u0454 \u043a\u0430\u043d\u0430\u043b\u0438.\n\n\u042f\u043a\u0449\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e, \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u0440\u043e\u0437\u0443\u043c\u0456\u043b\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u043e \u043f\u043e\u043c\u0438\u043b\u043a\u0443 \u0439 \u043d\u0435 \u043b\u0430\u043c\u0430\u0442\u0438 \u0432\u0435\u0441\u044c \u043f\u0440\u043e\u0446\u0435\u0441.\n\n\u0422\u0430\u043a\u043e\u0436 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u0437\u0430 \u0442\u0438\u043c, \u0449\u043e\u0431 \u0444\u0430\u0439\u043b\u043e\u0432\u0456 \u0434\u0435\u0441\u043a\u0440\u0438\u043f\u0442\u043e\u0440\u0438 \u0437\u0430\u043a\u0440\u0438\u0432\u0430\u043b\u0438\u0441\u044f \u0432\u0447\u0430\u0441\u043d\u043e.\n",
